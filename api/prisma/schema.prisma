generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum ProductUnitStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

enum RentalStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  TRANSFER
  OTHER
}

enum RentalRequestStatus {
  NEW
  QUOTED
  APPROVED
  REJECTED
  CONVERTED
}

enum MaintenanceStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(MANAGER)
  active       Boolean    @default(true)
  rentals      Rental[]   @relation("RentalCreatedBy")
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                    Int                    @id @default(autoincrement())
  categoryId            Int
  name                  String                 @unique
  description           String?
  quantity              Int                    @default(0)
  trackIndividualUnits  Boolean                @default(true)
  bufferBeforeMinutes   Int                    @default(0)
  bufferAfterMinutes    Int                    @default(0)
  defaultRateCents      Int                    @default(0)
  weightKg              Float?
  heightCm              Float?
  widthCm               Float?
  lengthCm              Float?
  color                 String?
  active                Boolean                @default(true)
  category              Category               @relation(fields: [categoryId], references: [id])
  units                 ProductUnit[]
  rentalItems           RentalItem[]
  reservations          EquipmentReservation[]
  rentalRequestProducts RentalRequestProduct[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([categoryId])
  @@index([active])
}

model ProductUnit {
  id                 Int                    @id @default(autoincrement())
  productId          Int
  identifier         String                 @unique
  status             ProductUnitStatus      @default(AVAILABLE)
  active             Boolean                @default(true)
  notes              String?
  product            Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  rentalItemUnits    RentalItemUnit[]
  reservations       EquipmentReservation[]
  maintenanceRecords MaintenanceRecord[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([productId, active])
}

model Customer {
  id        Int             @id @default(autoincrement())
  name      String
  contact   String
  email     String?
  notes     String?
  rentals   Rental[]
  requests  RentalRequest[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([name])
  @@index([contact])
}

model Employee {
  id          Int              @id @default(autoincrement())
  name        String
  contact     String?
  active      Boolean          @default(true)
  assignments RentalEmployee[]
  bookings    EmployeeBooking[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([name])
  @@index([active])
}

model EmployeeBooking {
  id         Int      @id @default(autoincrement())
  employeeId Int
  title      String
  startAt    DateTime
  endAt      DateTime
  notes      String?
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@index([employeeId, startAt, endAt])
}

model Rental {
  id               Int                    @id @default(autoincrement())
  code             String                 @unique
  customerId       Int
  createdById      Int?
  status           RentalStatus           @default(DRAFT)
  startAt          DateTime
  endAt            DateTime
  venue            String?
  finalAmountCents Int
  notes            String?
  finalNotes       String?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  customer         Customer               @relation(fields: [customerId], references: [id])
  createdBy        User?                   @relation("RentalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items            RentalItem[]
  employees        RentalEmployee[]
  reservations     EquipmentReservation[]
  payments         Payment[]
  auditLogs        AuditLog[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([customerId])
  @@index([status, startAt])
  @@index([startAt, endAt])
}

model RentalItem {
  id               Int                    @id @default(autoincrement())
  rentalId         Int
  productId        Int
  quantity         Int
  unitPriceCents   Int                    @default(0)
  rental           Rental                 @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  product          Product                @relation(fields: [productId], references: [id])
  units            RentalItemUnit[]
  reservations     EquipmentReservation[]

  @@unique([rentalId, productId])
  @@index([productId])
}

model RentalItemUnit {
  id            Int         @id @default(autoincrement())
  rentalItemId  Int
  productUnitId Int
  rentalItem    RentalItem  @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  productUnit   ProductUnit @relation(fields: [productUnitId], references: [id])

  @@unique([rentalItemId, productUnitId])
  @@index([productUnitId])
}

model RentalEmployee {
  rentalId   Int
  employeeId Int
  costCents  Int      @default(0)
  role       String   @default("Operator")
  rental     Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@id([rentalId, employeeId])
  @@index([employeeId])
}

model EquipmentReservation {
  id            Int               @id @default(autoincrement())
  rentalId      Int
  rentalItemId  Int
  productId     Int
  productUnitId Int?
  quantity      Int               @default(1)
  blockedFrom   DateTime
  blockedUntil  DateTime
  status        ReservationStatus @default(ACTIVE)
  rental        Rental            @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  rentalItem    RentalItem        @relation(fields: [rentalItemId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  productUnit   ProductUnit?      @relation(fields: [productUnitId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([productId, blockedFrom, blockedUntil])
  @@index([productUnitId, blockedFrom, blockedUntil])
  @@index([rentalId])
}

model Payment {
  id          Int           @id @default(autoincrement())
  rentalId    Int
  amountCents Int
  method      PaymentMethod @default(PIX)
  status      PaymentStatus @default(CONFIRMED)
  paidAt      DateTime      @default(now())
  notes       String?
  rental      Rental        @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([rentalId, status])
  @@index([paidAt])
}

model RentalRequest {
  id                   Int                     @id @default(autoincrement())
  customerId           Int
  status               RentalRequestStatus     @default(NEW)
  startAt              DateTime
  endAt                DateTime
  estimatedAmountCents Int?
  notes                String?
  customer             Customer                @relation(fields: [customerId], references: [id])
  products             RentalRequestProduct[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status, startAt])
}

model RentalRequestProduct {
  rentalRequestId Int
  productId       Int
  quantity        Int
  rentalRequest   RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@id([rentalRequestId, productId])
  @@index([productId])
}

model MaintenanceRecord {
  id            Int               @id @default(autoincrement())
  productUnitId Int
  startAt       DateTime
  endAt         DateTime?
  status        MaintenanceStatus @default(OPEN)
  description   String
  costCents     Int               @default(0)
  productUnit   ProductUnit       @relation(fields: [productUnitId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([productUnitId, status, startAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  rentalId   Int?
  action     String
  entityType String
  entityId   String
  details    Json?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rental     Rental?  @relation(fields: [rentalId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
